<div
  class="maps__container"
  data-controller="maps"
  data-maps-eco-icon-url-value="<%= asset_path('eco-icon.png') %>"
  data-maps-foodshare-icon-url-value="<%= asset_path('gift-icon.png') %>"
  data-maps-stores-value="<%= @stores_for_map_json.to_json %>"
  data-maps-is-company-value="<%= Current.user&.is_company? ? 'true' : 'false' %>"
  data-maps-company-restriction-message-value="<%= t('flash.reviews.company_restriction') %>"
></div>
<div class="comments__container hidden" data-controller="comments">
  <div class="comments__header">
    <p class="comments__text" data-comments-target="title">コメント</p>
    <button type="button" class="comments__btn--close" data-action="click->comments#hide">
      ×
    </button>
  </div>
  <div class="comments__list">
    <div class="comments__content" data-comments-target="content">
    </div>
  </div>
</div>
