<div class="admin__form">
  <h1 class="admin__title" style="text-align: center; margin-bottom: 1.5rem;"><%= t('admin.udon_shares.new.title') %></h1>

  <div class="admin__form-header">
    <p class="admin__form-store-name"><%= @store.name %></p>
    <p class="admin__form-store-address">📍 <%= @store.address %></p>
  </div>

  <%= form_with model: @udon_share, url: admin_store_udon_shares_path(@store) do |f| %>
    <% if @udon_share.errors.any? %>
      <div class="admin__errors">
        <h2 class="admin__errors-title"><%= t('admin.udon_shares.errors.header', count: @udon_share.errors.count) %></h2>

        <ul class="admin__errors-list">
          <% @udon_share.errors.full_messages.each do |message| %>
            <li class="admin__errors-item"><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="admin__form-group">
      <%= f.label :item_name, t('admin.udon_shares.form.item_name'), class: "admin__form-label admin__form-label--required" %>
      <%= f.text_field :item_name, class: "admin__form-input", placeholder: t('admin.udon_shares.form.item_name_placeholder') %>
    </div>

    <div class="admin__form-group">
      <%= f.label :description, t('admin.udon_shares.form.description'), class: "admin__form-label admin__form-label--required" %>
      <%= f.text_area :description, rows: 4, class: "admin__form-textarea", placeholder: t('admin.udon_shares.form.description_placeholder') %>
    </div>

    <div class="admin__form-group">
      <%= f.label :take_down_time, t('admin.udon_shares.form.take_down_time'), class: "admin__form-label admin__form-label--required" %>
      <%= f.datetime_local_field :take_down_time, class: "admin__form-input" %>
    </div>

    <div class="admin__form-group">
      <%= f.label :photo_url, t('admin.udon_shares.form.photo_url'), class: "admin__form-label admin__form-label--optional" %>
      <%= f.text_field :photo_url, class: "admin__form-input", placeholder: t('admin.udon_shares.form.photo_placeholder') %>
      <span class="admin__form-help"><%= t('admin.udon_shares.form.photo_help') %></span>
    </div>

    <div class="admin__form-actions">
      <%= f.submit t('admin.udon_shares.actions.submit'), class: "admin__btn admin__btn--primary admin__button-flex" %>
      <%= link_to t('admin.udon_shares.actions.cancel'), admin_stores_path, class: "admin__btn admin__btn--secondary" %>
    </div>
  <% end %>
</div>
