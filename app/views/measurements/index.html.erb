<p style="color: green"><%= notice %></p>
<% content_for :title, "Measurements" %>
<div class="measures">
  <div class="measures__list">
    <div class="measures__item">
      <% @measurements.each do |measurement| %>
      <%= render 'measurement_item', measurement: measurement %>
      <% end %>
    </div>
  </div>

  <%= render 'measure' %>
</div>
