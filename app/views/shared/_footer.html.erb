<footer class="footer__container">
  <%= form_with url: stores_path, method: :get, local: true, class: "footer__button" do %>
    <%= image_tag "search-bar-left.png", height: 50, alt: "" %>
    <input type="text" placeholder="検索" id="search-input" data-controller-search-bar-target="input" data-action="input->search-bar#adjustWidth">
    <span class="search-input-dummy" data-controller-search-bar-target="dummy"></span>
    <%= image_tag "search-bar-right.png", height: 50, alt: "" %>
  <% end %>
  <%# TODO: リンクを修正 %>
  <%= link_to "#", class: "footer__button" do %>
    <%= image_tag "estimate-btn.png", height: 50, alt: "水質推定" %>
  <% end %>
  <button
      type="button"
      class="footer__button"
      data-controller="foodshare"
      data-action="click->foodshare#foodshareChange"
    data-foodshare-active-url-value="<%= asset_path("foodshare_start-btn.png") %>"
    data-foodshare-inactive-url-value="<%= asset_path("foodshare_end-btn.png") %>"
    >
    <%= image_tag "foodshare_start-btn.png",
        height: 50,
        data: {foodshare_target: "icon" }
      %>
  </button>
</footer>
