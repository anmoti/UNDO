<%= form_with(model: review, class: "form", local: true) do |form| %>

  <%# reviewer_idがフォームから送信されることを確認する(見つからない場合、コントローラのCurrent.userがデフォルト) %>
  <% if defined?(Current) && Current.user %>
    <%= form.hidden_field :reviewer_id, value: (review.reviewer_id || Current.user.id) %>
  <% elsif review.reviewer_id.present? %>
    <%= form.hidden_field :reviewer_id, value: review.reviewer_id %>
  <% end %>

  <% if review.errors.any? %>
    <div class="careful">
      <h2><%= pluralize(review.errors.count, "error") %> prohibited this review from being saved:</h2>
      <ul>
        <% review.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form__field">
    <%= form.label :reviewee_id, "レビューするお店", class: "form__label" %>
    <%# TODO: 地図かドロップダウンリストか %>
    <%# TODO: ストアの選択UIを改善する（現在はテキスト入力）。 %>
    <%# form.collection_select :reviewee_id, producers, :id, :name, { include_blank: "選択してください" }, { class: "form__input" } %>

    <%= form.text_field :reviewee_id, class: "form__input" %>
  </div>

  <div class="form__field">
    <span class="form__label">評価</span>
    <div class="form__review--stars">
      <% 5.downto(1) do |i| %>
        <%= form.radio_button :rating, i, id: "star#{i}", class: "star-radio visually-hidden" %>
        <%= form.label :rating, for: "star#{i}", class: "star-label" do %>
          <svg role="img" aria-label="<%= i %>点">
            <title><%= i %>点</title>
            <use href="#star"></use>
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="form__field">
    <%= form.label :comment, "コメント", class: "form__label" %>
    <%= form.text_area :comment, class: "form__input" %>
  </div>

  <% if defined?(Current) && Current.user %>
    <%= form.submit "送信", class: "form__submit-btn" %>
  <% else %>
    <p class="notice">レビュー投稿にはサインインが必要です。</p>
  <% end %>

<% end %>
